{
  "name": "pi-message-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "playwright test",
    "patrol": "tsx scripts/patrol.ts",
    "shots": "tsx scripts/shots.ts",
    "markdown:review": "tsx scripts/markdown-full-review.ts",
    "screenshot": "python3 scripts/capture-ui.py",
    "test:live": "tsx tests/live-subscription.ts --live",
    "install:sync": "tsx scripts/install-sync.ts",
    "install:gpt-subagent": "tsx scripts/install-gpt-subagent.ts",
    "test:live-sync": "tsx tests/live-pi-sync.ts --live",
    "test:live-stream": "tsx tests/live-stream.ts --live",
    "test:live-pi-stream": "tsx tests/live-pi-stream.ts --live"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "express": "^5.1.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typebox": "1.3.27",
    "undici": "^8.12.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
